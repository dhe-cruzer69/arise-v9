# ARIEX4OPS local environment template
# Copy to .env for local use. Never commit real credentials.

# =============================================================================
# Database / event infrastructure (future application packages)
# =============================================================================
POSTGRES_URL=postgresql://<user>:<password>@localhost:5432/<database>
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI / LLM providers
# =============================================================================
OPENAI_API_KEY=<set-locally>
ANTHROPIC_API_KEY=<set-locally>
BLINK_API_KEY=<set-locally>

# =============================================================================
# GitHub App integration
# =============================================================================
GITHUB_APP_ID=<set-locally>
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=<set-locally>

# =============================================================================
# CAD / generated artifacts (future application packages)
# =============================================================================
CAD_OUTPUT_DIR=./output
CAD_TEMPLATE_DIR=./templates

# =============================================================================
# Dashboard (future application package)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
DASHBOARD_PORT=3000

# =============================================================================
# Infrastructure (future deployment modules)
# =============================================================================
AWS_REGION=<set-locally>
AWS_ACCESS_KEY_ID=<set-locally>
AWS_SECRET_ACCESS_KEY=<set-locally>
TERRAFORM_STATE_BUCKET=<set-locally>

cat > agent.py << 'EOF'
"""
ARIEX Autonomous Agent - Main entry point
Usage: python agent.py "Your task here"
"""
import sys, time
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))

from tools.filesystem import ReadFileTool, WriteFileTool, ListDirectoryTool
from tools.shell import RunShellTool
from tools.python import RunPythonTool, CheckSyntaxTool
from brain.planner import TaskPlanner
from brain.executor import StepExecutor
from brain.reflector import SelfReflector
from memory.store import AgentMemory

class AutonomousAgent:
    def __init__(self, model="qwen2.5-coder:7b", working_dir=".", max_iterations=30, auto_commit=False, verbose=True):
        self.model = model
        self.working_dir = Path(working_dir).absolute()
        self.max_iterations = max_iterations
        self.auto_commit = auto_commit
        self.verbose = verbose

        # Initialize tools
        self.tools = {
            "read_file": ReadFileTool(),
            "write_file": WriteFileTool(),
            "list_directory": ListDirectoryTool(),
            "run_shell": RunShellTool(),
            "run_python": RunPythonTool(),
            "check_syntax": CheckSyntaxTool(),
        }

        # Initialize brain
        self.planner = TaskPlanner(model=model)
        self.executor = StepExecutor(tools=self.tools)
        self.reflector = SelfReflector(model=model)
        self.memory = AgentMemory(working_dir=str(self.working_dir))

    def run(self, task: str) -> dict:
        start = time.time()
        files_modified = []
        errors = []

        if self.verbose:
            print(f"\n{'='*60}")
            print(f"🤖 ARIEX Autonomous Agent")
            print(f"{'='*60}")
            print(f"📋 Task: {task}")
            print(f"📂 Dir: {self.working_dir}")
            print(f"{'='*60}\n")

        # Phase 1: PLAN
        if self.verbose:
            print("🧠 Planning...")

        plan = self.planner.create_plan(task, str(self.working_dir), list(self.tools.keys()))

        if self.verbose:
            print(f"   Generated {len(plan)} steps")
            for i, step in enumerate(plan, 1):
                print(f"   {i}. {step.get('description', step)}")
            print()

        # Phase 2: EXECUTE
        steps_done = 0
        context = {"task": task, "working_dir": str(self.working_dir)}

        for i in range(min(len(plan), self.max_iterations)):
            step = plan[i]
            if self.verbose:
                print(f"⚙️  Step {i+1}/{len(plan)}: {step.get('description', '')[:60]}")

            result = self.executor.execute_step(step, context)

            if result["success"]:
                steps_done += 1
                if result.get("files_modified"):
                    files_modified.extend(result["files_modified"])
                if self.verbose:
                    print(f"   ✅ {result.get('summary', 'Done')}")
            else:
                if self.verbose:
                    print(f"   ❌ {result.get('error', 'Failed')}")
                    print(f"   🤔 Trying to recover...")

                recovery = self.reflector.recover_from_failure(step, result.get("error", ""), context, self.tools)
                if recovery["success"]:
                    steps_done += 1
                    if self.verbose:
                        print(f"   ✅ Recovered")
                else:
                    errors.append(f"Step {i+1}: {result.get('error', 'Unknown')}")
                    steps_done += 1  # Skip and continue

            if self.verbose:
                print()

        # Phase 3: REPORT
        duration = time.time() - start
        success = len(errors) == 0

        result = {
            "success": success,

"""Task planner - breaks tasks into steps."""
import json, re, requests

class TaskPlanner:
    def __init__(self, model="qwen2.5-coder:7b", ollama_url="http://localhost:11434"):
        self.model = model
        self.ollama_url = ollama_url

    def create_plan(self, task: str, working_dir: str, available_tools: list) -> list:
        prompt = f"""Break this task into steps. Return ONLY a JSON array.

Task: {task}

Available tools: {', '.join(available_tools)}

Format:
[
  {{"description": "what to do", "tool": "tool_name", "params": {{...}}, "expected_output": "what success looks like"}}
]

Steps:"""

        try:
            r = requests.post(f"{self.ollama_url}/api/generate", json={
                "model": self.model, "prompt": prompt, "stream": False,
                "options": {"temperature": 0.2}
            }, timeout=120)
            r.raise_for_status()
            text = r.json()["response"]

            # Try to parse JSON
            match = re.search(r'\[[\s\S]*\]', text)
            if match:
                return json.loads(match.group())
        except Exception:
            pass

        # Fallback plan
        return [{
            "description": f"Execute task: {task}",
            "tool": "run_shell",
            "params": {"command": f"echo 'Agent planning failed for: {task}'"},
            "expected_output": "Acknowledgment"
        }]
EOF
```


import subprocess, tempfile, ast
from pathlib import Path
from .base import Tool, ToolResult

class RunPythonTool(Tool):
    @property
    def name(self): return "run_python"
    @property
    def description(self): return "Run Python code. Params: code"

    def execute(self, code: str) -> ToolResult:
        try:
            with tempfile.NamedTemporaryFile(mode='w', suffix='.py', delete=False) as f:
                f.write(code)
                tmp = f.name
            try:
                r = subprocess.run(["python3", tmp], capture_output=True, text=True, timeout=30)
                return ToolResult(success=True, data={"stdout": r.stdout, "stderr": r.stderr, "returncode": r.returncode})
            finally:
                Path(tmp).unlink(missing_ok=True)
        except Exception as e:
            return ToolResult(success=False, error=str(e))

class CheckSyntaxTool(Tool):
    @property
    def name(self): return "check_syntax"
    @property
    def description(self): return "Check Python syntax. Params: code"

    def execute(self, code: str) -> ToolResult:
        try:
            ast.parse(code)
            return ToolResult(success=True, data={"valid": True, "errors": []})
        except SyntaxError as e:
            return ToolResult(success=True, data={"valid": False, "errors": [{"line": e.lineno, "message": e.msg}]})
        except Exception as e:
            return ToolResult(success=False, error=str(e))

"""Self-reflector - recovers from failures."""
import requests

class SelfReflector:
    def __init__(self, model="qwen2.5-coder:7b", ollama_url="http://localhost:11434"):
        self.model = model
        self.ollama_url = ollama_url

    def recover_from_failure(self, step: dict, error: str, context: dict, tools: dict) -> dict:
        # Simple recovery: ask LLM what to do
        prompt = f"""A step failed. Suggest recovery in 1-2 sentences.

Step: {step.get('description', '')}
Error: {error}

If you can fix it, describe the fix. If it should be skipped, say "SKIP". If you need more info, say "ASK: <what you need>".

Recovery:"""

        try:
            r = requests.post(f"{self.ollama_url}/api/generate", json={
                "model": self.model, "prompt": prompt, "stream": False,
                "options": {"temperature": 0.3}
            }, timeout=60)
            suggestion = r.json()["response"].strip()

            if suggestion.upper().startswith("SKIP"):
                return {"success": True, "summary": "Skipped", "files_modified": []}
            # For now, just skip on failure
            return {"success": False, "error": f"Could not auto-recover: {suggestion[:100]}"}
        except Exception:
            return {"success": False, "error": "Recovery failed"}
EOF
